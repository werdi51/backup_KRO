<Window x:Class="AutoSaver.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Title="Настройки" Height="330" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">

        <TextBlock Text="Настройки бэкапа" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Text="День месяца для полного бэкапа:" Foreground="#555" Margin="0,0,0,5"/>
        <ComboBox x:Name="CmbDay" Padding="5" Width="100" HorizontalAlignment="Left"/>
        <TextBlock Text="Если в месяце меньше дней, копия сделается в последний день месяца."
                   Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,15"/>

        <TextBlock Text="Сколько хранить ежедневные копии (дней):" Foreground="#555" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtDays" Padding="5" Width="100" HorizontalAlignment="Left"
                 MaxLength="3" PreviewTextInput="TxtDays_PreviewTextInput"/>
        <TextBlock Text="От 1 до 365. Более старые папки удаляются при следующем запуске."
                   Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="ОК" Width="80" Height="30" Margin="0,0,10,0" IsDefault="True" Click="BtnOk_Click" Background="LightGreen"/>
            <Button Content="Отмена" Width="80" Height="30" IsCancel="True" Background="Red"/>
        </StackPanel>
    </StackPanel>
</Window>